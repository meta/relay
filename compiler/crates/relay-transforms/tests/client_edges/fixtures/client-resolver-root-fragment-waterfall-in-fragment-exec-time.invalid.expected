# A fragment that an exec-time operation spreads is checked, `enabledProvider`
# included; a fragment that only other operations spread is not.
query ExecTimeQuery @exec_time_resolvers(enabledProvider: "ExecTimeProvider") {
  client_me {
    ...ExecTimeFragment
  }
}

query ReadTimeQuery {
  client_me {
    ...ReadTimeFragment
  }
}

fragment ExecTimeFragment on ClientUser {
  business_name
