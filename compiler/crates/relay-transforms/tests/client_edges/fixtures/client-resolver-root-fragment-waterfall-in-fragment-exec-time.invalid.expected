fragment ReadTimeFragment on ClientUser {
  business_name
}

fragment BusinessNameResolverFragment on ClientUser {
  business @waterfall {
    name
  }
}

# %extensions%

type ClientUser {
  business: Page @relay_resolver(import_path: "BusinessResolver")
