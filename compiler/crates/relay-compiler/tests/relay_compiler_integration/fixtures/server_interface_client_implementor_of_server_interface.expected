//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface CampaignGroup {
  id: ID!
  name: String
  specs: [Spec!]
}

interface Spec {
  interval_days: Int
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
  specs: [FrequencySpec!]
}

type FrequencySpec implements Spec {
  interval_days: Int
}
