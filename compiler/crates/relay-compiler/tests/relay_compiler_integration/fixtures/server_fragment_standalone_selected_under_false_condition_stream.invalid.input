//- src/ServerFriends.js

// The query spreads `ServerFriends_user` only under a statically false
// condition, which the query's own validation skips, so the fragment is
// validated as its own owner and its server-owned `@stream` is rejected.
graphql`query ServerFriendsQuery @server {
  me @include(if: false) {
    ...ServerFriends_user
  }
}`

graphql`fragment ServerFriends_user on User @server {
  friends @stream(initialCount: 1, label: "friends") {
    name
  }
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @stream(
  label: String!
  initialCount: Int!
  if: Boolean = true
  useCustomizedBatch: Boolean = false
) on FIELD

type Query {
  me: User
}

type User {
  name: String
  friends: [User]
}
