// A handed-off client fragment selects a Relay Resolver whose arguments read
// operation variables inside an object value (`$size`), a list value
// (`$small`, `$large`) and a provided variable (`$accent`). Its
// `rootVariables` lists them all, but not the fragment's own argument
// `$suffix`.
graphql`query ServerUserQuery($size: Int!, $small: Int!, $large: Int!) @server {
  me {
    ...ClientCard_user @alias(as: "card")
  }
}`

graphql`fragment ClientCard_user on User
  @argumentDefinitions(
    suffix: {type: "String", defaultValue: "!"}
    accent: {type: "String", provider: "./AccentProvider"}
  ) {
  pictureLabel(
    options: {size: $size, accent: $accent}
    sizes: [$small, $large]
    suffix: $suffix
  )
}`

