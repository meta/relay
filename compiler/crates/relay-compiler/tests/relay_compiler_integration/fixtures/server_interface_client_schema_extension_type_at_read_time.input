//- Queries.js
// `ClientGroup` is a client schema extension type without resolvers: its
// `name` is a store field under the storage key the selection on the
// interface reads, so a read-time query reads it.
graphql`query QueriesReadTimeQuery {
  client_groups {
    ...QueriesFragment
  }
}`

graphql`fragment QueriesFragment on CampaignGroup {
  name
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["extensions"],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface CampaignGroup {
  id: ID!
  name: String
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
}

//- extensions/extension.graphql
type ClientGroup implements CampaignGroup {
  id: ID!
  name: String
}

extend type Query {
  client_groups: [CampaignGroup]
}
