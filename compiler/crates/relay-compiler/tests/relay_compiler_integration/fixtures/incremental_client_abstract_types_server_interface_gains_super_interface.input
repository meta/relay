//- NamedFragment.js
// The client schema extension type `ClientEntity` implements the server
// interface `ISub`. The server makes `ISub` implement `IBase`, so `ClientEntity`
// implements `IBase` too: the incremental build lists it under `__isIBase`, as
// a full build does.
graphql`fragment NamedFragment on IBase {
  name
}`

//- NamedQuery.js
graphql`query NamedQuery {
  base {
    ...NamedFragment
  }
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["extensions"],
  "featureFlags": {
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  base: IBase
  sub: ISub
}

interface IBase {
  name: String
}

interface ISub {
  name: String
}

type ServerBase implements IBase {
  name: String
}

type ServerEntity implements ISub {
  name: String
}

//- extensions/extension.graphql
type ClientEntity implements ISub {
  name: String
}

//-++ schema.graphql
type Query {
  base: IBase
  sub: ISub
}

interface IBase {
  name: String
}

interface ISub implements IBase {
  name: String
}

type ServerBase implements IBase {
  name: String
}

type ServerEntity implements ISub & IBase {
  name: String
}
