//- src/ServerDeferred.js

// No `relayRsc` block, so the default `nextjs` mode resolves
// `allowIncrementalDelivery` to true and the server-owned operation can defer
// a server fragment.
graphql`query ServerDeferredQuery @server {
  me {
    ...ServerDeferred_user @defer(label: "ServerDeferredQuery$user")
  }
}`

graphql`fragment ServerDeferred_user on User @server {
  name
}`

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  me: User
}

type User {
  name: String
}
