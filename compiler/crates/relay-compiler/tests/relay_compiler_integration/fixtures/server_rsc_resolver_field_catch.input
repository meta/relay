//- src/Page.js

// A failed RSC field is an ordinary Relay field error, so `@catch` on an RSC
// field is accepted in server documents and in client fragments: the Reader
// wraps the field in a `CatchField` (`RESULT` by default) and its type is a
// `Result`. The server operation and the handoff do not change.
graphql`query ServerRscCatchQuery @server {
  me {
    panel: rscPanel @catch
    ...ClientCard_user @alias(as: "card")
  }
}`

graphql`fragment ClientCard_user on User {
  panel: rscPanel @catch(to: NULL)
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  name
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "flow",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
