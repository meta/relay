//- src/Page.js

// Two RSC fields whose root fragments both select a third RSC field and hand
// off the same client fragment: the server query's handoff lists each
// descriptor and each client boundary once.
graphql`query ServerRscNestedSharedQuery @server {
  me {
    left: rscLeft
    right: rscRight
  }
}`

//- src/RscLeft.js

/**
 * @relayField User.rscLeft: RelayRscValue
 * @rootFragment RscLeft_user
 */
graphql`fragment RscLeft_user on User @server {
  name
  shared: rscShared
}`

export function RscLeft() {}

//- src/RscRight.js

/**
 * @relayField User.rscRight: RelayRscValue
 * @rootFragment RscRight_user
