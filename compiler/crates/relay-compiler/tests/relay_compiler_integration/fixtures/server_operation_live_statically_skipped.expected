//- src/ServerUser.js

// `@live` under a statically false condition is never fetched, so the
// server-owned live delivery check skips it, as the incremental delivery
// check does.
graphql`query ServerUserQuery @server {
  me {
    name
    liveName: name @include(if: false) @live
  }
}`

