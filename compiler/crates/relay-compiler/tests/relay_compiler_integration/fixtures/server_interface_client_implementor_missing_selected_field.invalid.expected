graphql`fragment CampaignFragment on CampaignGroup {
  name
}`

//- ServerOnlyQuery.js
// Below a server field only server objects appear: no error for `name` here.
graphql`query ServerOnlyQuery {
  group {
    ... on CampaignGroup {
      name
    }
  }
}`

