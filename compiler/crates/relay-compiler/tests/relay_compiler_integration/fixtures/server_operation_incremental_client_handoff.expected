// The client projection keeps the label of a deferred server fragment that
// reaches a client fragment, keeps the client fragment's own `@stream`, and
// drops a deferred fragment that selects only server fields.
graphql`query ServerFeedQuery @server {
  me {
    ...ServerProfile_user @defer(label: "profile")
    ...ServerOnly_user @defer(label: "serverOnly")
  }
}`

graphql`fragment ServerProfile_user on User @server {
  secret
  ...ClientCard_user @alias(as: "clientCard")
}`

graphql`fragment ServerOnly_user on User @server {
  secret
}`

graphql`fragment ClientCard_user on User {
  name
  friends @stream(initialCount: 1, label: "friends") {
    name
  }
}`

