//- CampaignFragment.js
// Without client implementors of server interfaces, `$__relay_exec_time` is an
// ordinary variable: the compiler declares nothing.
graphql`fragment CampaignFragment on Query {
  group @include(if: $__relay_exec_time) {
    name
  }
}`

//- CampaignQuery.js
graphql`query CampaignQuery {
  ...CampaignFragment
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface CampaignGroup {
  id: ID!
  name: String
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
}
