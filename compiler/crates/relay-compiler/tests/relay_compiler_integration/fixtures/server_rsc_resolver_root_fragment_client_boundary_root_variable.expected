//- src/Page.js

// An RSC root fragment that only hands off a client fragment reads nothing on
// the server, so the root variable that client fragment reads (`$size`) is
// not one of the root fragment's free root variables. The server query
// supplies it: the nested boundary's `rootVariables` name it, and the
// query's `$size` counts as used, though only the nested boundary reads it.
graphql`query ServerRscBoundaryRootVariableQuery($size: Int) @server {
  me {
    panel: rscPanel
  }
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  ...ClientPicture_user @alias(as: "picture")
}`

export function RscPanel() {}

//- src/ClientPicture.js

graphql`fragment ClientPicture_user on User {
  profilePicture(size: $size) {
    uri
  }
}`

