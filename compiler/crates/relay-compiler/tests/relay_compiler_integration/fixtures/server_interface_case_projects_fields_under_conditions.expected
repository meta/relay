//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface Owner {
  name: String
  email: String
}

type User implements Owner {
  name: String
  email: String
}

interface CampaignGroup {
  id: ID!
  owner: Owner
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  owner: User
}
