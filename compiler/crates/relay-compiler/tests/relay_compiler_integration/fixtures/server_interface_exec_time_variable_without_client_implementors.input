//- CampaignQuery.js
// The flag names `CampaignGroup`, which no client type implements yet: the
// compiler still declares `$__relay_exec_time` for a fragment that reads it.
graphql`query CampaignQuery @exec_time_resolvers {
  ...CampaignQuery_root
}`

graphql`fragment CampaignQuery_root on Query {
  group {
    name @include(if: $__relay_exec_time)
  }
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "limited", "allowlist": ["CampaignGroup"] }
  }
}

//- schema.graphql
type Query { group: CampaignGroup }
interface CampaignGroup { id: ID! name: String }
type AdCampaignGroup implements CampaignGroup { id: ID! name: String }
