//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

directive @stream(
  label: String!
  initialCount: Int!
  if: Boolean = true
) on FIELD

type Query {
  me: User
  node(id: ID!): Node
}

type Mutation {
  updateUser: User
}

type Subscription {
  userUpdated: User
}

interface Node {
  id: ID!
}

type User implements Node {
  id: ID!
  name: String
  friends: [User]
}
