graphql`fragment ClientCard_user on User {
  panel: rscPanel
  ...ClientFriends_user
}`

graphql`fragment ClientFriends_user on User @inline {
  friends @stream(label: "ClientFriends_user$friends", initialCount: 1) {
    name
  }
}`

