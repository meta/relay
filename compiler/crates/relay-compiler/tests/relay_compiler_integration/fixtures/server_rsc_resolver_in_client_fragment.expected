//- src/Page.js

// A client fragment that a server query hands off may select a Relay RSC
// field: the server query's handoff lists the field's descriptor, one level
// below the client boundary.
graphql`query ServerRscInClientFragmentQuery @server {
  me {
    ...ClientCard_user @alias(as: "card")
  }
}`

//- src/ClientCard.js

graphql`fragment ClientCard_user on User {
  name
  panel: rscPanel
}`

