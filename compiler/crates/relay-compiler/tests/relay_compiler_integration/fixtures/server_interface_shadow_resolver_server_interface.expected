directive @semanticNonNull on FIELD_DEFINITION
type Query { groups: [AdCampaignGroup!]! }
interface ICampaignGroup {
  id: ID!
  frequency_control_specs: [IFrequencyControlSpec!] @semanticNonNull
}
interface IFrequencyControlSpec {
  interval_days: Int @semanticNonNull
  max_frequency: Int @semanticNonNull
}
type AdCampaignGroup implements ICampaignGroup {
  id: ID!
  frequency_control_specs: [FrequencyControlSpec!]!
}
type FrequencyControlSpec implements IFrequencyControlSpec {
  interval_days: Int @semanticNonNull
  max_frequency: Int @semanticNonNull
}

