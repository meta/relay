//- CampaignFragment.js
// Only `$__relay_exec_time` proves exec time: `@include` on a provided variable
// does not, even one read from the operation's own exec-time provider.
graphql`fragment CampaignFragment on CampaignGroup {
  name
}`

//- CampaignRoot.js
graphql`fragment CampaignRootFragment on Query
  @argumentDefinitions(
    isShadow: {type: "Boolean!", provider: "ExecTimeProvider.relayprovider"}
  ) {
  client_group @include(if: $isShadow) {
    ...CampaignFragment
  }
}`

//- CampaignQuery.js
graphql`query CampaignQuery @exec_time_resolvers(enabledProvider: "ExecTimeProvider") {
  ...CampaignRootFragment
}`

//- ClientCampaignGroup.js
/**
 * @relayType ClientCampaignGroup implements CampaignGroup
 */
export function ClientCampaignGroup(id: string) {}

/**
 * @relayField ClientCampaignGroup.name: String
 */
export function name() {}

/**
 * @relayField Query.client_group: CampaignGroup
 */
export function client_group() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface CampaignGroup {
  id: ID!
  name: String
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
}
==================================== OUTPUT ===================================
✖︎ `ClientCampaignGroup` implements the server interface `CampaignGroup` and serves `name` with its own resolver, which only exec time reads: the executor computes it when the query runs. `CampaignQuery` reaches this selection and runs at read time when its provider `ExecTimeProvider` returns false, where an object of `ClientCampaignGroup` would have no `name`. Select this under `@include(if: $__relay_exec_time)`, remove `enabledProvider` from the `@exec_time_resolvers` of `CampaignQuery`, or select this inside `... on` the server types.

