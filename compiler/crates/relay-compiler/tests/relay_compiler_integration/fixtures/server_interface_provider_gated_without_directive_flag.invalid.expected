//- CampaignFragment.js
// `@exec_time_resolvers(enabledProvider:)` without
// `enable_exec_time_resolvers_directive`: turning the flag on would leave the
// query gated by its provider, so the remedy offers the guard, not the flag.
graphql`fragment CampaignFragment on CampaignGroup {
  name
}`

//- CampaignQuery.js
graphql`query CampaignQuery @exec_time_resolvers(enabledProvider: "ExecTimeProvider") {
  client_group {
    ...CampaignFragment
  }
}`

