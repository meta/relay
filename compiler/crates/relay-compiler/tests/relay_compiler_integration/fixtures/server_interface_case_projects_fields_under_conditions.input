//- CampaignQuery.js
graphql`query CampaignQuery($cond: Boolean!) @exec_time_resolvers {
  client_group {
    ...CampaignFragment
  }
}`

//- CampaignFragment.js
// `ClientCampaignGroup` serves `owner` with a resolver returning the weak model
// `ClientOwner`, so its case reads `ClientOwner`'s resolvers below `owner`,
// under the condition and the inline fragment too.
graphql`fragment CampaignFragment on CampaignGroup {
  owner {
    name @include(if: $cond)
    ... {
      email
    }
  }
}`

//- ClientCampaignGroup.js
/**
 * @relayType ClientCampaignGroup implements CampaignGroup
 */
export function ClientCampaignGroup(id: string) {}

/**
 * @relayField ClientCampaignGroup.owner: ClientOwner
 */
export function owner() {}

/**
 * @relayField Query.client_group: CampaignGroup
 */
export function client_group() {}

//- ClientOwner.js
/**
 * @relayType ClientOwner implements Owner
 * @weak
 */
export type ClientOwner = {name: string};

/**
 * @relayField ClientOwner.name: String
 */
export function name() {}

/**
 * @relayField ClientOwner.email: String
 */
export function email() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface Owner {
  name: String
  email: String
}

type User implements Owner {
  name: String
  email: String
}

interface CampaignGroup {
  id: ID!
  owner: Owner
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  owner: User
}
