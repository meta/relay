//- CampaignFragment.js
// `CampaignGroup` is a server interface. The server implements it with
// `AdCampaignGroup` and may add implementors at any time; the client
// implements it with the Relay Resolver types `ClientCampaignGroup` and
// `ClientSpec`. The fragment reads `name` and `specs` on the interface, as
// the server sent them, for every server type; the `ClientCampaignGroup` case
// reads the resolvers. The nested `specs` selection on the interface needs no
// case: a server field holds server objects.
graphql`fragment CampaignFragment on CampaignGroup {
  name
  specs {
    interval_days
  }
}`

//- CampaignQueries.js
// Below the server field `group` only server objects appear, so neither the
// query text nor normalization lists `ClientCampaignGroup`. Below the
// resolver `client_group` a client object can appear, so normalization keeps
// its case.
graphql`query CampaignQueriesServerQuery @exec_time_resolvers {
  group {
    ...CampaignFragment
  }
}`

graphql`query CampaignQueriesClientQuery @exec_time_resolvers {
  client_group {
    ...CampaignFragment
  }
}`

//- ClientCampaignGroup.js
/**
 * @relayType ClientCampaignGroup implements CampaignGroup
 */
export function ClientCampaignGroup(id: string) {}

/**
 * @relayField ClientCampaignGroup.name: String
 */
export function name() {}

/**
 * @relayField ClientCampaignGroup.specs: [ClientSpec!]
 */
export function specs() {}

/**
 * @relayField Query.client_group: CampaignGroup
 */
export function client_group() {}

//- ClientSpec.js
/**
 * @relayType ClientSpec implements Spec
 * @weak
 */
export type ClientSpec = {interval_days: number};

/**
 * @relayField ClientSpec.interval_days: Int
 */
export function interval_days() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface CampaignGroup {
  id: ID!
  name: String
  specs: [Spec!]
}

interface Spec {
  interval_days: Int
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
  specs: [FrequencySpec!]
}

type FrequencySpec implements Spec {
  interval_days: Int
}
