//- AccountFragment.js
// The `@refetchable` fragment reaching the server interface `CampaignGroup`
// drops `@exec_time_resolvers` from its `directives`, so its generated query
// runs at read time. The rule reports the generated query, as in a full build.
graphql`fragment AccountFragment on Query
  @refetchable(queryName: "AccountRefetchQuery", directives: ["@exec_time_resolvers"]) {
  client_group {
    ...CampaignFragment
  }
}`

//- AccountQuery.js
graphql`query AccountQuery @exec_time_resolvers {
  ...AccountFragment
}`

//- CampaignFragment.js
graphql`fragment CampaignFragment on CampaignGroup {
  name
}`

//- ClientCampaignGroup.js
/**
 * @relayType ClientCampaignGroup implements CampaignGroup
 */
export function ClientCampaignGroup(id: string) {}

/**
 * @relayField ClientCampaignGroup.name: String
 */
export function name() {}

/**
 * @relayField Query.client_group: CampaignGroup
 */
export function client_group() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

interface CampaignGroup {
  id: ID!
  name: String
  budget: Int
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
  budget: Int
}

//-++ AccountFragment.js
graphql`fragment AccountFragment on Query
  @refetchable(queryName: "AccountRefetchQuery") {
  client_group {
    ...CampaignFragment
  }
}`
