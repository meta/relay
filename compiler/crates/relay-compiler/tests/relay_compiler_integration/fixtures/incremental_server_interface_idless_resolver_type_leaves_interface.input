//- SpecFragment.js
// `OtherSpec` has no `id` and serves the client field `note` of `Spec` with a
// resolver of its own, so it has a case. The server stops making `OtherSpec`
// implement `Spec`: the incremental build drops the case, as a full build does.
graphql`fragment SpecFragment on Spec {
  note
}`

//- SpecQuery.js
graphql`query SpecQuery @exec_time_resolvers {
  group {
    spec {
      ...SpecFragment
    }
  }
}`

//- ClientSpec.js
/**
 * @relayType ClientSpec implements Spec
 * @weak
 */
export type ClientSpec = {note: string};

/**
 * @relayField ClientSpec.note: String
 */
export function note() {}

//- OtherSpecResolvers.js
/**
 * @relayField OtherSpec.note: String
 * @rootFragment OtherSpecResolversFragment
 */
export function note() {}

graphql`fragment OtherSpecResolversFragment on OtherSpec {
  __typename
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["extensions"],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  group: AdCampaignGroup
}

type AdCampaignGroup {
  id: ID!
  spec: Spec
}

interface Spec {
  interval_days: Int
}

type FrequencySpec implements Spec {
  interval_days: Int
}

type OtherSpec implements Spec {
  interval_days: Int
}

//- extensions/extension.graphql
extend interface Spec {
  note: String
}

extend type FrequencySpec {
  note: String
}

//-++ schema.graphql
type Query {
  group: AdCampaignGroup
}

type AdCampaignGroup {
  id: ID!
  spec: Spec
}

interface Spec {
  interval_days: Int
}

type FrequencySpec implements Spec {
  interval_days: Int
}

type OtherSpec {
  interval_days: Int
}
