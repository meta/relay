directive @stream(label: String!, initialCount: Int!, if: Boolean = true, useCustomizedBatch: Boolean = false) on FIELD
directive @defer(label: String!, if: Boolean = true) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  group: AdCampaignGroup
}

interface Member {
  name: String
}

type User implements Member {
  name: String
}

interface CampaignGroup {
  id: ID!
  members: [Member]
}

type AdCampaignGroup implements CampaignGroup {
  id: ID!
  members: [User]
}
