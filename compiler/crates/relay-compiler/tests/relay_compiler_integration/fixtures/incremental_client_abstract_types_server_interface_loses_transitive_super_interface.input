//- NamedFragment.js
// `ISub` implements `IBase`, which implements `ITop`, so the client type
// `ClientEntity` (implements `ISub`) is listed under `__isITop`. The server
// makes `ISub` stop implementing `IBase`: the incremental build no longer lists
// it, as a full build does not.
graphql`fragment NamedFragment on ITop {
  name
}`

//- NamedQuery.js
graphql`query NamedQuery {
  top {
    ...NamedFragment
  }
}`

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["extensions"],
  "featureFlags": {
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query {
  top: ITop
}

interface ITop {
  name: String
}

interface IBase implements ITop {
  name: String
}

interface ISub implements IBase {
  name: String
}

type ServerTop implements ITop {
  name: String
}

//- extensions/extension.graphql
type ClientEntity implements ISub {
  name: String
}

//-++ schema.graphql
type Query {
  top: ITop
}

interface ITop {
  name: String
}

interface IBase implements ITop {
  name: String
}

interface ISub {
  name: String
}

type ServerTop implements ITop {
  name: String
}
