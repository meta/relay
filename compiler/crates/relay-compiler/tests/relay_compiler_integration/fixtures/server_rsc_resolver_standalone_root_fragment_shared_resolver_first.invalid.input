//- src/Page.js

// The same documents as
// `server_rsc_resolver_standalone_root_fragment_shared_spread_first`, but
// `Shared_user` is reached outside a Relay Resolver root fragment by the
// standalone `ServerShell_user`, which is validated after `RscPanel_user`.
// The `@defer` is rejected inside the Resolver root fragment either way.
graphql`fragment ServerShell_user on User @server {
  ...Shared_user
}`

graphql`fragment Shared_user on User @server {
  ...DeferredName_user @defer(label: "Shared_user$name")
}`

graphql`fragment DeferredName_user on User @server {
  name
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  ...Shared_user
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
