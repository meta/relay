//- CampaignFragment.js
// `owner` is a client field of the server interface `CampaignGroup`, and
// `Owner` has a client implementor too. The weak model `ClientOwner` lacks
// `email`, which is reported once.
graphql`fragment CampaignFragment on CampaignGroup {
  owner {
    email
  }
}`

//- CampaignQuery.js
graphql`query CampaignQuery @exec_time_resolvers {
  client_group {
    ...CampaignFragment
  }
}`

//- ClientCampaignGroup.js
