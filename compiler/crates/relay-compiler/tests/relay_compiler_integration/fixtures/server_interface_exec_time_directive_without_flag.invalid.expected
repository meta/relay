//- CampaignQuery.js
// Without `enable_exec_time_resolvers_directive`, normalization does not
// compute the resolvers of a query with `@exec_time_resolvers`, so the compiler
// checks it as a read-time query.
graphql`query CampaignQuery @exec_time_resolvers {
  client_group {
    name
  }
}`

