//- src/Page.js

// A fragment selected with `@module` cannot reach a Relay RSC field, even in a
// client fragment that a server query hands off.
graphql`query ServerRscModuleQuery @server {
  me {
    ...ClientRenderer_user @alias(as: "renderer")
  }
}`

//- src/ClientRenderer.js

graphql`fragment ClientRenderer_user on User {
  nameRenderer @match {
    ...ClientRenderer_plainRenderer @module(name: "PlainRenderer.react")
  }
}`

graphql`fragment ClientRenderer_plainRenderer on PlainUserNameRenderer {
  plaintext
  panel: rscPanel
}`

//- src/RscPanel.js

/**
 * @relayField PlainUserNameRenderer.rscPanel: RelayRscValue
 * @rootFragment RscPanel_renderer
 */
graphql`fragment RscPanel_renderer on PlainUserNameRenderer @server {
  plaintext
}`

export function RscPanel() {}

