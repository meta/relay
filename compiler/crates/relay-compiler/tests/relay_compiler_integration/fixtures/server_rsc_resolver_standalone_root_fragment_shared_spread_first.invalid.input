//- src/Page.js

// The query reaches `Shared_user` outside a Relay Resolver root fragment,
// where its `@defer` is allowed. No query selects `rscPanel`, so its root
// fragment `RscPanel_user` is validated as its own owner, and the same
// `@defer` is rejected inside it. The query's walk of `Shared_user` does not
// stand in for the Resolver root fragment's.
graphql`query PageQuery @server {
  me {
    ...Shared_user
  }
}`

graphql`fragment Shared_user on User @server {
  ...DeferredName_user @defer(label: "Shared_user$name")
}`

graphql`fragment DeferredName_user on User @server {
  name
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  ...Shared_user
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

type Query {
  me: User
}

type User {
  id: ID!
  name: String
}
