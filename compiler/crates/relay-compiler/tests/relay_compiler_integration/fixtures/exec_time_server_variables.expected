  $id: ID!
  $style: String!
  $withEmail: Boolean!
  $fragmentStyle: String!
) @exec_time_resolvers @preloadable {
  node(id: $id) {
    id
    ... on User {
      email @include(if: $withEmail)
    }
  }
  greeting(style: $style)
  ...ServerVariablesQuery_fragment @arguments(style: $fragmentStyle)
}`

