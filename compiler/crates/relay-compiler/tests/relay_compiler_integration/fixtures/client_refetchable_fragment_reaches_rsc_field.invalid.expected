//- src/Page.js

// The query generated for a `@refetchable` fragment is a client query, so a
// fragment that is refetched or paginated from the client (`@refetchable`,
// `@connection`) cannot reach a Relay RSC field, even when a server query
// hands it off. Both generated queries are rejected with a message that names
// the fragment.
graphql`query ServerRscRefetchableQuery @server {
  me {
    ...Cards_card @alias(as: "card")
    ...Cards_friends @alias(as: "friends")
  }
}`

//- src/Cards.js

graphql`fragment Cards_card on User
  @refetchable(queryName: "CardsRefetchQuery") {
  name
  panel: rscPanel
}`

graphql`fragment Cards_friends on User
  @argumentDefinitions(count: {type: "Int", defaultValue: 2}, cursor: {type: "String"})
  @refetchable(queryName: "CardsFriendsPaginationQuery") {
  friends(first: $count, after: $cursor) @connection(key: "Cards_friends") {
    edges {
      node {
        panel: rscPanel
      }
    }
  }
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  name
}`

export function RscPanel() {}

