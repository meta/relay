//- src/Page.js

// A client fragment may `@stream` wherever a server document hands it off:
// here both directly from the query and from the root fragment of a Relay RSC
// field that another client fragment selects. The query spreads the RSC field's
// client fragment first, then the streaming one; `server_rsc_resolver_client_fragment_stream_reversed`
// spreads them in the other order.
graphql`query ServerRscClientStreamQuery @server {
  me {
    ...ClientCard_user @alias(as: "card")
    ...ClientFriends_user @alias(as: "friends")
  }
}`

//- src/ClientCard.js

graphql`fragment ClientCard_user on User {
  panel: rscPanel
}`

//- src/ClientFriends.js

graphql`fragment ClientFriends_user on User {
  friends @stream(label: "ClientFriends_user$friends", initialCount: 1) {
    name
  }
}`

//- src/RscPanel.js

/**
 * @relayField User.rscPanel: RelayRscValue
 * @rootFragment RscPanel_user
 */
graphql`fragment RscPanel_user on User @server {
  name
  ...ClientFriends_user @alias(as: "friends")
}`

export function RscPanel() {}

//- relay.config.json
{
  "sources": {"src": "test_project"},
  "projects": {
    "test_project": {
      "schema": "schema.graphql",
      "language": "javascript",
      "jsModuleFormat": "commonjs",
      "featureFlags": {
        "enable_relay_rsc": true
      }
    }
  }
}

//- schema.graphql
directive @defer(
  label: String!
  if: Boolean = true
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

directive @stream(
  label: String!
  initialCount: Int!
  if: Boolean = true
) on FIELD

type Query {
  me: User
  node(id: ID!): Node
}

type Mutation {
  updateUser: User
}

type Subscription {
  userUpdated: User
}

interface Node {
  id: ID!
}

type User implements Node {
  id: ID!
  name: String
  friends: [User]
}
