}

//- schema.graphql
type Query { group: AdCampaignGroup }
type Mutation { rename_group: CampaignGroup }
type Subscription { group_updated: CampaignGroup }
interface CampaignGroup {
  id: ID!
  name: String
}
type AdCampaignGroup implements CampaignGroup {
  id: ID!
  name: String
}

//- extensions/extension.graphql
extend interface CampaignGroup { ad_object_id: String }
