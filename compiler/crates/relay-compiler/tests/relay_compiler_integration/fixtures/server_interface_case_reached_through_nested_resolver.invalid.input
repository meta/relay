//- CampaignQuery.js
// The case is reached through `inner_label`'s root fragment, inside
// `outer_label`'s: the error names `outer_label`, the only one a guard can be
// put on.
graphql`query CampaignQuery {
  group {
    outer_label
  }
}`

//- Outer.js
/**
 * @relayField AdCampaignGroup.outer_label: String
 * @rootFragment Outer_fragment
 */
export function outer_label() {}
graphql`fragment Outer_fragment on AdCampaignGroup {
  inner_label
}`

//- Inner.js
/**
 * @relayField AdCampaignGroup.inner_label: String
 * @rootFragment Inner_fragment
 */
export function inner_label() {}
graphql`fragment Inner_fragment on AdCampaignGroup {
  parent { ad_object_id }
}`

//- ClientCampaignGroup.js
/**
 * @relayType ClientCampaignGroup implements CampaignGroup
 */
export function ClientCampaignGroup(id: string) {}
/**
 * @relayField ClientCampaignGroup.ad_object_id: String
 */
export function ad_object_id() {}
/**
 * @relayField AdCampaignGroup.ad_object_id: String
 */
export function server_ad_object_id() {}

//- relay.config.json
{
  "language": "flow",
  "jsModuleFormat": "haste",
  "schema": "schema.graphql",
  "schemaExtensions": ["extensions"],
  "featureFlags": {
    "enable_exec_time_resolvers_directive": true,
    "relay_resolver_enable_interface_output_type": { "kind": "enabled" },
    "enable_client_implementors_of_server_abstract_types": { "kind": "enabled" }
  }
}

//- schema.graphql
type Query { group: AdCampaignGroup }
interface CampaignGroup { id: ID! name: String }
type AdCampaignGroup implements CampaignGroup { id: ID! name: String parent: CampaignGroup }

//- extensions/extension.graphql
extend interface CampaignGroup { ad_object_id: String }
