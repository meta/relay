# validate-extracted-schema
# When nothing selected implements both Entity and Node, the generated Node
# refinement under the abstract Entity field keeps one shared type, so the
# project's compile still adds it.

//- src/GeneratedNodeSpreadQuery.js
graphql`
  query GeneratedNodeSpreadQuery {
    entity {
      url
    }
  }
`;

//- relay.config.json
{
  "language": "typescript",
  "schema": "./schema.graphql",
  "src": "./src"
}

//- schema.graphql
type Query { _: ID }

//- full_schema.graphql
directive @fetchable(field_name: String!) on OBJECT
directive @strong(field_name: String!) on OBJECT

type Query {
  entity: Entity
}

interface Entity {
  url: String
}

interface Node {
  id: ID
}

type FirstEntity implements Entity & Node @fetchable(field_name: "id") @strong(field_name: "id") {
  id: ID
  url: String
}

type SecondEntity implements Entity & Node @fetchable(field_name: "id") @strong(field_name: "id") {
  id: ID
  url: String
}
